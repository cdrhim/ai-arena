SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-publishable-key
SUPABASE_SECRET_KEY=replace-with-server-side-supabase-secret-key
SPARKLABS_ARENA_ADMIN_DOMAINS=sparklabs.co.kr
SPARKLABS_ARENA_ADMIN_EMAILS=admin@sparklabs.co.kr
# Enable only after the Google provider and production redirect URL are configured in Supabase Auth.
SPARKLABS_ARENA_GOOGLE_ADMIN_LOGIN_ENABLED=false
SPARKLABS_ARENA_MEMBER_DOMAINS=
SPARKLABS_ARENA_MEMBER_EMAILS=
SPARKLABS_ARENA_B2B_PARTNER_DOMAINS=
SPARKLABS_ARENA_B2B_PARTNER_EMAILS=
SPARKLABS_ARENA_HUMAN_VALIDATOR_DOMAINS=
SPARKLABS_ARENA_HUMAN_VALIDATOR_EMAILS=
# AI Arena community and curated partner discovery are enabled by default.
# Outcome bounties and public technical disclosure remain staged.
SPARKCLAW_ENABLE_ARENA=false
SPARKCLAW_ENABLE_FORUM=true
SPARKCLAW_ENABLE_B2B_PORTAL=true
# Keep Claw Member join/submit/opportunity actions locked until a real sponsor brief is approved.
SPARKCLAW_ENABLE_BOUNTIES=false
SPARKCLAW_ENABLE_PUBLIC_TECH_DISCLOSURE=false
SPARKCLAW_COMPETITION_STORAGE=netlify_blobs
ANTHROPIC_API_KEY=replace-with-server-side-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=replace-with-server-side-gemini-key
GEMINI_COMPARE_MODEL=gemini-2.5-flash
GEMINI_EVENT_MODEL=gemini-2.5-flash
GEMINI_ARENA_GUIDE_MODEL=gemini-2.5-flash
SPARKCLAW_ARENA_GUIDE_LIMIT_PER_HOUR=40
SPARKCLAW_B2B_MATCH_LIMIT_PER_HOUR=20
SPARKCLAW_B2B_MATCH_WINDOW_MS=3600000
SPARKCLAW_EVENT_RECOMMENDATION_LIMIT_PER_HOUR=20
SPARKCLAW_EVENT_RECOMMENDATION_WINDOW_MS=3600000
# Safe company/event profiles shown to authenticated partner roles require explicit consent allowlists.
SPARKCLAW_PUBLIC_TEAM_IDS=
# Optional stricter subset for external partner/LP discovery. Falls back to SPARKCLAW_PUBLIC_TEAM_IDS.
SPARKCLAW_PARTNER_VISIBLE_TEAM_IDS=
SPARKCLAW_PUBLIC_EVENT_IDS=
SPARKCLAW_PUBLIC_BRIEF_LIMIT_PER_HOUR=5
SPARKCLAW_PROGRAM_SUPABASE_URL=https://fismlrkkppqmkfpgctue.supabase.co
SPARKCLAW_PROGRAM_SUPABASE_SECRET_KEY=replace-with-server-side-program-secret-key
SPARKCLAW_PROGRAM_DB_ALLOWED_EMAILS=
